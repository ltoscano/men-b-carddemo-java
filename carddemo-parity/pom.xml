<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ltoscano.carddemo</groupId>
    <artifactId>carddemo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>carddemo-parity</artifactId>
  <name>carddemo-parity</name>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>carddemo-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>carddemo-loader</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>carddemo-online</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>carddemo-batch</artifactId>
    </dependency>
    <!-- Classi di test di carddemo-domain (issue #60): l'ispezione del codice compilato di
         NoFloatingPointBytecodeTest, riusata sulle classi di carddemo-loader. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>carddemo-domain</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test di integrazione con PostgreSQL reale. Versioni gestite da Spring Boot 4.2.0
         (Testcontainers 2.0.5, driver PostgreSQL 42.7.14, SnakeYAML 2.7). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test della tabella dei conti (issue #59): i test applicano la migrazione con l'API di
         Flyway. Versioni gestite da Spring Boot 4.2.0 (Flyway 12.11.0). -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Rapporto aggregato di copertura: unisce i file di esecuzione e le classi di tutti i
           moduli da cui parity dipende. Fase verify, percorso fisso (vedi docs/sviluppo.md). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>rapporto-aggregato</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
              <formats>
                <format>XML</format>
              </formats>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- compose.yaml della radice del repository (cartella del POM padre), non della
                 cartella del modulo: il test ne legge l'immagine del servizio db. -->
            <menb.compose.file>${project.parent.basedir}/compose.yaml</menb.compose.file>
            <!-- Contratto dati del record dei conti (#3), letto dal repository dal test di
                 corrispondenza tra tabella e contratto (issue #59), non copiato. -->
            <menb.contratto.account>${project.parent.basedir}/docs/legacy-map/data-contract/contratti/CVACT01Y.ACCOUNT-RECORD.tsv</menb.contratto.account>
            <!-- File dei conti che legge l'oracle (#53), letto dal repository dai test del
                 caricamento (issue #60), non copiato. -->
            <menb.dati.acctfile>${project.parent.basedir}/analysis/oracle-dati/out/ACCTFILE.rec</menb.dati.acctfile>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
