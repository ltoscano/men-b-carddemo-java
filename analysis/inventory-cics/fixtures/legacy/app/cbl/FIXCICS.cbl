       IDENTIFICATION DIVISION.
       PROGRAM-ID. FIXCICS.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-COSTANTI.
          05 WS-FILE-OK        PIC X(8) VALUE 'FIXFILE '.
          05 WS-FILE-MOSSO     PIC X(8) VALUE 'ALTRO   '.
          05 WS-TRANS-OK       PIC X(4) VALUE 'FX01'.
          05 WS-CODA-OK        PIC X(8) VALUE 'FIXQ'.
          05 WS-CALL-PROG      PIC X(8) VALUE 'FIXTGT'.
          05 WS-FLAG-PROG      PIC X(8) VALUE 'FIXTGT'.
             88 FLAG-PROG-X              VALUE 'FIXTGT2'.
          05 WS-SQL-PROG       PIC X(8) VALUE 'FIXTGT'.
          05 WS-MAPSET         PIC X(7) VALUE 'FIXSET '.
          05 WS-PROG-MULTI     PIC X(8)
                               VALUE 'FIXTGT'.
       01 WS-GRUPPO.
          05 WS-PROG-GRUPPO    PIC X(8) VALUE 'FIXTGT'.
       01 WS-RIDEF             PIC X(8) VALUE 'FIXTGT'.
       01 WS-RIDEF-X REDEFINES WS-RIDEF PIC X(8).
       01 WS-SENZA-VALUE       PIC X(8).
       01 WS-DUP-A.
          05 WS-DUP            PIC X(8) VALUE 'FIXTGT'.
       01 WS-DUP-B.
          05 WS-DUP            PIC X(8) VALUE 'FIXTGT'.
       01 WS-OCC.
          05 WS-OCC-EL OCCURS 2.
             10 WS-OCC-PROG    PIC X(8) VALUE 'FIXTGT'.
       01 WS-REC               PIC X(10).
       01 WS-KEY               PIC X(4).
       LINKAGE SECTION.
       01 LK-PROG              PIC X(8).
       PROCEDURE DIVISION.
           MOVE 'XXXXXXXX' TO WS-FILE-MOSSO.
           INITIALIZE WS-GRUPPO.
           MOVE SPACES TO WS-RIDEF-X.
           CALL 'FIXSUB' USING WS-CALL-PROG.
           SET FLAG-PROG-X TO TRUE.
           EXEC SQL SELECT C INTO :WS-SQL-PROG FROM T END-EXEC.
           MOVE WS-FILE-OK TO WS-REC.
           IF WS-TRANS-OK = 'FX01' DISPLAY WS-CODA-OK END-IF.
           EXEC CICS WRITE DATASET(WS-FILE-OK) FROM(WS-REC)
                LENGTH(10) RIDFLD(WS-KEY) END-EXEC.
           EXEC CICS DELETE FILE('FIXFILE') RIDFLD(WS-KEY) END-EXEC.
           EXEC CICS READ DATASET(WS-FILE-MOSSO) INTO(WS-REC) END-EXEC.
           EXEC CICS READ FILE('FIXFILE') UPDATE INTO(WS-REC) END-EXEC.
           EXEC CICS WRITEQ TS QUEUE(WS-CODA-OK) FROM(WS-REC) END-EXEC.
           EXEC CICS READQ TD QUEUE('FIXTDQ') INTO(WS-REC) END-EXEC.
           EXEC CICS DELETEQ TS QUEUE('FIXQ') END-EXEC.
           EXEC CICS DELETEQ QUEUE('FIXQ2') END-EXEC.
           EXEC CICS START TRANSID(WS-TRANS-OK) END-EXEC.
           EXEC CICS SEND TEXT FROM(WS-REC) END-EXEC.
      *    EXEC CICS XCTL PROGRAM('COMMENTO') END-EXEC.
           MOVE 1 TO WS-KEY. *> EXEC CICS RETURN END-EXEC
           DISPLAY 'EXEC CICS RETURN END-EXEC'.
           EXEC CICS XCTL PROGRAM(WS-PROG-GRUPPO) END-EXEC.
           EXEC CICS LINK PROGRAM(WS-RIDEF) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-CALL-PROG) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-FLAG-PROG) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-SQL-PROG) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-SENZA-VALUE) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-DUP) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-OCC-PROG) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-NON-ESISTE) END-EXEC.
           EXEC CICS XCTL PROGRAM(LK-PROG) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-OCC-PROG(1)) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-PROG-MULTI) END-EXEC.
           EXEC CICS SYNCPOINT END-EXEC. EXEC CICS ASKTIME END-EXEC.
           EXEC CICS LINK
                PROGRAM
                ('FIXTGT')
           END-EXEC.
           EXEC CICS XCTL PROGRAM('NOPROG') END-EXEC.
           EXEC CICS XCTL PROGRAM('EXTBASE') END-EXEC.
           EXEC CICS RETURN TRANSID('ZZ99') END-EXEC.
           EXEC CICS SEND MAP('FIXMAP') END-EXEC.
           EXEC CICS SEND MAP('FIXMAP') MAPSET(WS-MAPSET) END-EXEC.
           EXEC CICS RECEIVE MAP('FIXMAP ') MAPSET('FIXSET')            XCTLJUNK
                INTO(WS-REC) END-EXEC.
           COPY FIXCPY.
           EXEC CICS ABEND ABCODE('FX01') END-EXEC.
           EXEC CICS SYNCPOINT ROLLBACK END-EXEC.
           EXEC CICS SEND MAP('FIXMAP') MAPSET(WS-SENZA-VALUE) END-EXEC.
           GOBACK.
