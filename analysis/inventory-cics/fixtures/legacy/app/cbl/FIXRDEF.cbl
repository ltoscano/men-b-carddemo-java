       IDENTIFICATION DIVISION.
       PROGRAM-ID. FIXRDEF.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 BASE-AREA.
          05 WS-PGM            PIC X(8) VALUE 'FIXTGT'.
       01 ALIAS-AREA REDEFINES BASE-AREA.
          05 ALIAS-F           PIC X(8).
       01 ALIAS-TWO REDEFINES ALIAS-AREA.
          05 ALIAS-TWO-F       PIC X(8).
       01 BASE3.
          05 WS-PGM3           PIC X(8) VALUE 'FIXTGT'.
       01 R3A REDEFINES BASE3.
          05 R3A-F             PIC X(8).
       01 R3B REDEFINES R3A.
          05 R3B-F             PIC X(8).
       01 R3C REDEFINES R3B.
          05 R3C-F             PIC X(8).
       01 GRP-C.
          05 SUB-C.
             10 WS-PGM-C       PIC X(8) VALUE 'FIXTGT'.
          05 SUB-C-R1 REDEFINES SUB-C.
             10 SUB-C-R1-F     PIC X(8).
          05 SUB-C-R2 REDEFINES SUB-C-R1.
             10 SUB-C-R2-F     PIC X(8).
       01 BASE-OK.
          05 WS-PGM-OK         PIC X(8) VALUE 'FIXTGT'.
       01 ALIAS-OK REDEFINES BASE-OK.
          05 ALIAS-OK-F        PIC X(8).
       01 ALIAS-OK2 REDEFINES ALIAS-OK.
          05 ALIAS-OK2-F       PIC X(8).
       01 WS-OUT.
          05 WS-PGM-A          PIC X(8) VALUE 'FIXTGT'.
          05 WS-K-INTO         PIC X(8) VALUE 'FIXTGT'.
          05 WS-K-RID          PIC X(8) VALUE 'FIXTGT'.
          05 WS-K-RET          PIC X(8) VALUE 'FIXTGT'.
          05 WS-K-ABS          PIC X(8) VALUE 'FIXTGT'.
          05 WS-K-FMT          PIC X(8) VALUE 'FIXTGT'.
          05 WS-K-MAPI         PIC X(8) VALUE 'FIXTGT'.
          05 WS-K-COMM         PIC X(8) VALUE 'FIXTGT'.
          05 WS-K-RESP         PIC X(8) VALUE 'FIXTGT'.
          05 WS-K-INQ          PIC X(8) VALUE 'FIXTGT'.
          05 WS-K-LEN          PIC X(8) VALUE 'FIXTGT'.
          05 WS-REC            PIC X(8).
       PROCEDURE DIVISION.
           MOVE 'CHANGED' TO ALIAS-TWO-F.
           MOVE 'CHANGED' TO R3C-F.
           MOVE 'CHANGED' TO SUB-C-R2-F.
           EXEC CICS XCTL PROGRAM(WS-PGM) END-EXEC.
           EXEC CICS LINK PROGRAM(WS-PGM3) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-PGM-C) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-PGM-OK) END-EXEC.
           EXEC CICS ASSIGN PROGRAM(WS-PGM-A) END-EXEC.
           EXEC CICS LINK PROGRAM(WS-PGM-A) END-EXEC.
           EXEC CICS READ FILE('FIXFILE') INTO(WS-K-INTO) END-EXEC.
           EXEC CICS READNEXT FILE('FIXFILE') INTO(WS-REC)
                RIDFLD(WS-K-RID) END-EXEC.
           EXEC CICS RETRIEVE INTO(WS-K-RET) END-EXEC.
           EXEC CICS ASKTIME ABSTIME(WS-K-ABS) END-EXEC.
           EXEC CICS FORMATTIME ABSTIME(WS-REC) YYYYMMDD(WS-K-FMT)
           END-EXEC.
           EXEC CICS RECEIVE MAP('FIXMAP') MAPSET('FIXSET')
                INTO(WS-K-MAPI) END-EXEC.
           EXEC CICS LINK PROGRAM('FIXTGT') COMMAREA(WS-K-COMM)
           END-EXEC.
           EXEC CICS READ FILE('FIXFILE') INTO(WS-REC) RESP(WS-K-RESP)
           END-EXEC.
           EXEC CICS INQUIRE PROGRAM(WS-K-INQ) END-EXEC.
           EXEC CICS RECEIVE INTO(WS-REC) LENGTH(WS-K-LEN) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-K-INTO) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-K-RID) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-K-RET) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-K-ABS) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-K-FMT) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-K-MAPI) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-K-COMM) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-K-RESP) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-K-INQ) END-EXEC.
           EXEC CICS XCTL PROGRAM(WS-K-LEN) END-EXEC.
           GOBACK.
