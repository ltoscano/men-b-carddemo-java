# Valori di SVILUPPO, non segreti: sono gli stessi predefiniti in compose.yaml, che
# funziona anche senza questo file. Per cambiarli: copiare in .env (ignorato da git).
# Non usare questi valori fuori dalla macchina di sviluppo.

# Database PostgreSQL (servizio "db"): nome, utente e password.
MENB_DB_NAME=carddemo
MENB_DB_USER=carddemo
MENB_DB_PASSWORD=carddemo-sviluppo

# Porta HTTP dell'host su cui viene pubblicato il servizio online.
MENB_ONLINE_PORT=8080
