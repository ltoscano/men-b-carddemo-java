<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.2.0</version>
    <relativePath/>
  </parent>

  <groupId>io.github.ltoscano.carddemo</groupId>
  <artifactId>carddemo-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>carddemo-parent</name>
  <description>Migrazione di AWS CardDemo da COBOL a Java: scheletro multi-modulo</description>

  <modules>
    <module>carddemo-domain</module>
    <module>carddemo-loader</module>
    <module>carddemo-online</module>
    <module>carddemo-batch</module>
    <module>carddemo-parity</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Versioni fissate dei controlli di #26. Enforcer: gestita da Spring Boot 4.2.0
         (maven-enforcer-plugin.version). Checkstyle e ArchUnit non sono gestiti da Spring Boot:
         ultime versioni stabili su Maven Central al 27 nov 2026. -->
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <checkstyle.version>14.4.0</checkstyle.version>
    <archunit.version>1.5.1</archunit.version>
    <!-- Versioni fissate dei controlli di #27: ne' JaCoCo ne' SpotBugs sono gestiti da Spring
         Boot 4.2.0 (spring-boot-dependencies-4.2.0.pom non li contiene): ultime versioni
         stabili su Maven Central al 27 nov 2026. SpotBugs si fissa anche nel motore
         (com.github.spotbugs:spotbugs), non solo nel plugin. -->
    <jacoco.version>0.8.16</jacoco.version>
    <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
    <spotbugs.version>4.10.5</spotbugs.version>
    <!-- Identificativo della corsa: ./verify.sh lo passa con -Dmenb.verify.run=<corsa>; senza,
         resta "locale". Surefire lo registra nel rapporto dei test, l'agente JaCoCo come
         identificativo di sessione nel file di esecuzione di ogni modulo. -->
    <menb.verify.run>locale</menb.verify.run>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>carddemo-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>carddemo-loader</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>carddemo-online</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>carddemo-batch</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Divieto di tipi in virgola mobile e di var nel codice di produzione (vedi
             quality/regole/checkstyle.xml). Le dipendenze di Checkstyle sono fissate qui. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
          <executions>
            <execution>
              <id>tipi-vietati</id>
              <phase>validate</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <configLocation>${project.parent.basedir}/quality/regole/checkstyle.xml</configLocation>
                <includeTestSourceDirectory>false</includeTestSourceDirectory>
                <consoleOutput>true</consoleOutput>
                <failsOnError>true</failsOnError>
                <failOnViolation>true</failOnViolation>
                <violationSeverity>warning</violationSeverity>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <!-- Analisi statica dei difetti sul codice di produzione (vedi docs/sviluppo.md): i
             moduli di produzione lo dichiarano, cosi' riceve versione e configurazione da qui. -->
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-maven-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.github.spotbugs</groupId>
              <artifactId>spotbugs</artifactId>
              <version>${spotbugs.version}</version>
            </dependency>
          </dependencies>
          <!-- Configurazione a livello di plugin e non dell'esecuzione: l'obiettivo check lancia
               in fork l'obiettivo spotbugs con l'esecuzione predefinita, che non riceve la
               configurazione di "analisi-difetti" (verificato: effort, soglia e filtro non venivano
               applicati all'analisi). -->
          <configuration>
            <effort>Max</effort>
            <threshold>Medium</threshold>
            <failOnError>true</failOnError>
            <xmlOutput>true</xmlOutput>
            <includeTests>false</includeTests>
            <!-- niente file di esclusioni: ne' oggi ne' per default -->
          </configuration>
          <executions>
            <execution>
              <id>analisi-difetti</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Copertura dei test: l'agente JaCoCo si attiva in tutti i moduli (fase initialize) e
           scrive target/jacoco.exec, con la corsa come identificativo di sessione. Il rapporto
           aggregato lo produce solo carddemo-parity (fase verify, vedi il suo POM). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>agente-copertura</id>
            <phase>initialize</phase>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco.exec</destFile>
              <sessionId>${menb.verify.run}</sessionId>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Database incorporati vietati in ogni modulo e ambito. Due esecuzioni: la ricerca
           transitiva non vede le dipendenze dirette optional, quella diretta si'. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>database-incorporati</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.h2database:*</exclude>
                    <exclude>org.hsqldb:*</exclude>
                    <exclude>hsqldb:*</exclude>
                    <exclude>org.apache.derby:*</exclude>
                    <exclude>derby:*</exclude>
                    <exclude>org.apache.servicemix.bundles:org.apache.servicemix.bundles.hsqldb*</exclude>
                    <exclude>org.apache.servicemix.bundles:org.apache.servicemix.bundles.derby*</exclude>
                    <exclude>org.apache.servicemix.bundles:org.apache.servicemix.bundles.h2*</exclude>
                  </excludes>
                  <message>DATABASE-INCORPORATO-VIETATO</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
          <execution>
            <id>database-incorporati-diretti</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>com.h2database:*</exclude>
                    <exclude>org.hsqldb:*</exclude>
                    <exclude>hsqldb:*</exclude>
                    <exclude>org.apache.derby:*</exclude>
                    <exclude>derby:*</exclude>
                    <exclude>org.apache.servicemix.bundles:org.apache.servicemix.bundles.hsqldb*</exclude>
                    <exclude>org.apache.servicemix.bundles:org.apache.servicemix.bundles.derby*</exclude>
                    <exclude>org.apache.servicemix.bundles:org.apache.servicemix.bundles.h2*</exclude>
                  </excludes>
                  <message>DATABASE-INCORPORATO-VIETATO</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Driver di database incorporati vietati sul classpath effettivo di ogni modulo
           (compile, runtime, provided, optional, test), qualunque coordinata li porti. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>${maven-antrun-plugin.version}</version>
        <executions>
          <execution>
            <id>classi-database-vietate</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                    <available property="vietata.0" classname="org.h2.Driver" classpathref="maven.test.classpath"/>
                    <available property="vietata.1" classname="org.h2.jdbcx.JdbcDataSource" classpathref="maven.test.classpath"/>
                    <available property="vietata.2" classname="org.hsqldb.jdbc.JDBCDriver" classpathref="maven.test.classpath"/>
                    <available property="vietata.3" classname="org.hsqldb.jdbcDriver" classpathref="maven.test.classpath"/>
                    <available property="vietata.4" classname="org.apache.derby.jdbc.EmbeddedDriver" classpathref="maven.test.classpath"/>
                    <available property="vietata.5" classname="org.apache.derby.iapi.jdbc.AutoloadedDriver" classpathref="maven.test.classpath"/>
                    <fail message="DATABASE-INCORPORATO-CLASSE-VIETATA: driver di database incorporato sul classpath di ${project.artifactId}">
                      <condition>
                        <or>
                        <isset property="vietata.0"/>
                        <isset property="vietata.1"/>
                        <isset property="vietata.2"/>
                        <isset property="vietata.3"/>
                        <isset property="vietata.4"/>
                        <isset property="vietata.5"/>
                        </or>
                      </condition>
                    </fail>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
